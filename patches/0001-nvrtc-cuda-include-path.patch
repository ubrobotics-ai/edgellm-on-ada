+    // naming that file. EDGELLM_NVRTC_INCLUDE overrides for relocatable installs.
+    {
+        char const* const cudaInclude = std::getenv("EDGELLM_NVRTC_INCLUDE");
+        options.emplace_back(std::string("-I")
+            + (cudaInclude != nullptr ? cudaInclude : "/usr/local/cuda/include"));
+    }
     options.emplace_back("-DGENERATE_CUBIN=1");
     options.emplace_back("-DNDEBUG");
     options.emplace_back("-DINFINITY=__int_as_float(0x7f800000)");
